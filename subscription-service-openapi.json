{
  "openapi": "3.0.0",
  "info": {
    "title": "Subscription Service API",
    "description": "Complete API specification for the Subscription Service microservice",
    "version": "1.0.0",
    "contact": {
      "name": "RDC Backend Team",
      "email": "backend@ruchitadesigncompany.in"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8094",
      "description": "Development Server"
    },
    {
      "url": "https://ruchitadesigncompany.in/api/subscriptions",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/public/subscriptions/plans": {
      "get": {
        "tags": [
          "Plans"
        ],
        "summary": "Get All Subscription Plans",
        "description": "Retrieve all active subscription plans available for purchase",
        "operationId": "getPlans",
        "security": [],
        "responses": {
          "200": {
            "description": "List of active plans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/subscriptions/purchase": {
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Purchase Subscription",
        "description": "Create a new subscription for the authenticated user",
        "operationId": "purchaseSubscription",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseSubscriptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data"
          },
          "401": {
            "description": "Unauthorized - Invalid JWT token"
          },
          "403": {
            "description": "Forbidden - Invalid role"
          }
        }
      }
    },
    "/api/subscriptions/me": {
      "get": {
        "tags": [
          "My Subscriptions"
        ],
        "summary": "Get My Subscription",
        "description": "Get the authenticated user's current subscription details",
        "operationId": "getMySubscription",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionSummaryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Subscription not found"
          }
        }
      }
    },
    "/api/subscriptions/me/usage": {
      "get": {
        "tags": [
          "My Subscriptions"
        ],
        "summary": "Get My Usage Statistics",
        "description": "Get the authenticated user's usage statistics",
        "operationId": "getMyUsage",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usage statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionSummaryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Subscription not found"
          }
        }
      }
    },
    "/api/subscriptions/me/credits": {
      "get": {
        "tags": [
          "My Subscriptions"
        ],
        "summary": "Get My Available Credits",
        "description": "Get the authenticated user's available credits count",
        "operationId": "getMyCredits",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Available credits count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "example": 850
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Subscription not found"
          }
        }
      }
    },
    "/api/subscriptions/initiate-payment": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Initiate Subscription Payment",
        "description": "Initiate payment for a subscription plan",
        "operationId": "initiatePayment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateSubscriptionPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateSubscriptionPaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/internal/subscriptions/validate-ai": {
      "post": {
        "tags": [
          "Internal - AI Operations"
        ],
        "summary": "Validate AI Usage",
        "description": "Validate if a user can perform AI operation based on subscription",
        "operationId": "validateAi",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          }
        }
      }
    },
    "/api/internal/subscriptions/consume-ai": {
      "post": {
        "tags": [
          "Internal - AI Operations"
        ],
        "summary": "Consume AI Credits",
        "description": "Deduct credits from user's subscription for AI usage",
        "operationId": "consumeAi",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsumeAiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credits consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          }
        }
      }
    },
    "/api/internal/subscriptions/validate-design": {
      "post": {
        "tags": [
          "Internal - Design Operations"
        ],
        "summary": "Validate Design Usage",
        "description": "Validate if a user can perform design operation based on subscription",
        "operationId": "validateDesign",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesignValidationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          }
        }
      }
    },
    "/api/internal/subscriptions/consume-design": {
      "post": {
        "tags": [
          "Internal - Design Operations"
        ],
        "summary": "Consume Design Credits",
        "description": "Deduct credits from user's subscription for design usage",
        "operationId": "consumeDesign",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsumeDesignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credits consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Insufficient credits"
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          }
        }
      }
    },
    "/api/internal/subscriptions/users/{userId}/summary": {
      "get": {
        "tags": [
          "Internal - User Management"
        ],
        "summary": "Get User Subscription Summary",
        "description": "Get subscription summary for a specific user",
        "operationId": "getSubscriptionSummary",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionSummaryResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/internal/subscriptions/activate": {
      "post": {
        "tags": [
          "Internal - Activation"
        ],
        "summary": "Activate Subscription",
        "description": "Activate a subscription for a user",
        "operationId": "activateSubscription",
        "security": [
          {
            "InternalKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription activated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseSubscriptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Forbidden - Invalid Internal Key"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlanResponse": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "planName": {
            "type": "string",
            "example": "Pro Plan"
          },
          "description": {
            "type": "string",
            "example": "For professionals"
          },
          "monthlyPrice": {
            "type": "number",
            "format": "decimal",
            "example": 59.99
          },
          "credits": {
            "type": "integer",
            "example": 1000
          },
          "aiUsageLimit": {
            "type": "integer",
            "example": 100
          },
          "designUsageLimit": {
            "type": "integer",
            "example": 50
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Unlimited AI",
              "Priority Support"
            ]
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "planId",
          "planName",
          "monthlyPrice",
          "credits"
        ]
      },
      "PurchaseSubscriptionRequest": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "description": "ID of the subscription plan"
          }
        },
        "required": [
          "planId"
        ]
      },
      "PurchaseSubscriptionResponse": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456
          },
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "status": {
            "type": "string",
            "example": "ACTIVE",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "EXPIRED",
              "CANCELLED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "example": "2024-02-15T10:30:00Z"
          },
          "availableCredits": {
            "type": "integer",
            "example": 1000
          }
        },
        "required": [
          "subscriptionId",
          "userId",
          "planId",
          "status",
          "availableCredits"
        ]
      },
      "SubscriptionSummaryResponse": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456
          },
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "planName": {
            "type": "string",
            "example": "Pro Plan"
          },
          "status": {
            "type": "string",
            "example": "ACTIVE"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "example": "2024-02-15T10:30:00Z"
          },
          "availableCredits": {
            "type": "integer",
            "example": 850
          },
          "totalCredits": {
            "type": "integer",
            "example": 1000
          },
          "usedCredits": {
            "type": "integer",
            "example": 150
          },
          "aiUsageCount": {
            "type": "integer",
            "format": "int64",
            "example": 45
          },
          "designUsageCount": {
            "type": "integer",
            "format": "int64",
            "example": 12
          }
        },
        "required": [
          "subscriptionId",
          "userId",
          "planId",
          "status"
        ]
      },
      "InitiateSubscriptionPaymentRequest": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "description": "ID of the subscription plan"
          },
          "paymentMethod": {
            "type": "string",
            "example": "CARD",
            "description": "Payment method (CARD, UPI, etc.)"
          },
          "amount": {
            "type": "number",
            "format": "decimal",
            "example": 29.99,
            "description": "Payment amount"
          }
        },
        "required": [
          "planId",
          "paymentMethod",
          "amount"
        ]
      },
      "InitiateSubscriptionPaymentResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "example": "PAY-12345"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456
          },
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "amount": {
            "type": "number",
            "format": "decimal",
            "example": 29.99
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "status": {
            "type": "string",
            "example": "PENDING"
          },
          "paymentUrl": {
            "type": "string",
            "example": "https://payment-gateway.example.com/pay/PAY-12345"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T11:30:00Z"
          }
        },
        "required": [
          "paymentId",
          "userId",
          "planId",
          "amount",
          "status"
        ]
      },
      "AiValidationRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456,
            "description": "User ID"
          },
          "creditsRequired": {
            "type": "integer",
            "example": 10,
            "description": "Credits needed for AI operation"
          }
        },
        "required": [
          "userId",
          "creditsRequired"
        ]
      },
      "AiValidationResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456
          },
          "isValid": {
            "type": "boolean",
            "example": true
          },
          "reason": {
            "type": "string",
            "example": "User has sufficient credits"
          },
          "availableCredits": {
            "type": "integer",
            "example": 850
          },
          "creditsRequired": {
            "type": "integer",
            "example": 10
          }
        },
        "required": [
          "userId",
          "isValid",
          "availableCredits"
        ]
      },
      "ConsumeAiRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456,
            "description": "User ID"
          },
          "creditsToConsume": {
            "type": "integer",
            "example": 10,
            "description": "Credits to deduct"
          },
          "requestId": {
            "type": "string",
            "example": "REQ-AI-12345",
            "description": "Unique request identifier (for idempotency)"
          }
        },
        "required": [
          "userId",
          "creditsToConsume"
        ]
      },
      "DesignValidationRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456,
            "description": "User ID"
          },
          "creditsRequired": {
            "type": "integer",
            "example": 5,
            "description": "Credits needed for design operation"
          }
        },
        "required": [
          "userId",
          "creditsRequired"
        ]
      },
      "DesignValidationResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456
          },
          "isValid": {
            "type": "boolean",
            "example": true
          },
          "reason": {
            "type": "string",
            "example": "User has sufficient credits for design"
          },
          "availableCredits": {
            "type": "integer",
            "example": 850
          },
          "creditsRequired": {
            "type": "integer",
            "example": 5
          }
        },
        "required": [
          "userId",
          "isValid",
          "availableCredits"
        ]
      },
      "ConsumeDesignRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456,
            "description": "User ID"
          },
          "creditsToConsume": {
            "type": "integer",
            "example": 5,
            "description": "Credits to deduct"
          },
          "requestId": {
            "type": "string",
            "example": "REQ-DESIGN-12345",
            "description": "Unique request identifier (for idempotency)"
          }
        },
        "required": [
          "userId",
          "creditsToConsume"
        ]
      },
      "ActivateSubscriptionRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "example": 456,
            "description": "User ID"
          },
          "planId": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "description": "Plan ID to activate"
          }
        },
        "required": [
          "userId",
          "planId"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth2 JWT Bearer token from Auth Service"
      },
      "InternalKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-INTERNAL-KEY",
        "description": "Internal service key for service-to-service communication"
      }
    }
  },
  "tags": [
    {
      "name": "Plans",
      "description": "Subscription plans browsing"
    },
    {
      "name": "Subscriptions",
      "description": "User subscription operations"
    },
    {
      "name": "My Subscriptions",
      "description": "Authenticated user subscription details"
    },
    {
      "name": "Payments",
      "description": "Subscription payment operations"
    },
    {
      "name": "Internal - AI Operations",
      "description": "Service-to-service AI credit operations"
    },
    {
      "name": "Internal - Design Operations",
      "description": "Service-to-service design credit operations"
    },
    {
      "name": "Internal - User Management",
      "description": "Service-to-service user management"
    },
    {
      "name": "Internal - Activation",
      "description": "Service-to-service subscription activation"
    }
  ]
}
